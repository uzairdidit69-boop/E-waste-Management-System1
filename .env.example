# .env.example
# Copy this file to .env and fill in the real values.

# PostgreSQL connection (Neon free tier)
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<db>"
# Unpooled URL for Alembic migrations (Neon pooler separate)
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>-pooler:5432/<db>"

# JWT secret (minimum 64 characters)
JWT_SECRET="replace-with-64-char-secret"

# Environment (development or production)
ENVIRONMENT=development
