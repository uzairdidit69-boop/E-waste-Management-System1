# .env.example
# Copy this file to .env and fill in the values for local development or Vercel environment variables.

# Neon PostgreSQL connection string (pooled / PgBouncer URL for runtime serverless)
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.region.neon.tech/<db>?sslmode=require"

# Neon PostgreSQL direct connection string (unpooled URL for Alembic migrations from local CLI)
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>.region.neon.tech/<db>?sslmode=require"

# Secret key for signing JWT tokens (generate using: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET="replace-with-at-least-64-character-random-secret"

# JWT token expiration in minutes (default: 60)
JWT_EXPIRE_MINUTES=60

# Allowed CORS origins for local development (comma-separated). In Vercel production, frontend & API share one domain.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Application environment ("development" or "production")
ENV=development

# Optional: Frontend API base URL (defaults to relative "/api" on Vercel deployment)
VITE_API_URL="/api"
